{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePack",
  "type": "object",
  "properties": {
    "trace_id": { "type": "string" },
    "consumer_agent": { "type": "string" },
    "query": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string" },
          "document_id": { "type": "string" },
          "chunk_id": { "type": "string" },
          "content": { "type": "string" },
          "relevance_score": { "type": "number" },
          "authority_level": { "type": "string" },
          "section_title": { "type": "string" },
          "page_number": { "type": ["integer", "null"] }
        },
        "required": ["source_id", "document_id", "chunk_id", "content", "relevance_score", "authority_level"]
      }
    },
    "retrieved_at": { "type": "string" }
  },
  "required": ["trace_id", "consumer_agent", "query", "items", "retrieved_at"]
}
